MCP_ENV=dev
MCP_NAME=service_mcp
MCP_TRANSPORT=streamable-http
MCP_CONFIG_PRIORITY=init_first
MCP_CACHE_ENABLED=True

# 认证模式: tool(工具模式/无鉴权) | admin(管理模式/转发鉴权)
MCP_AUTH_MODE=tool
# 认证服务校验 API 地址（管理模式时必需）
MCP_AUTH_API_URL=https://example.com/api/auth/validate

# ── 日志配置 ──────────────────────────────────────────────────────────────
# 框架级日志级别（官方 FastMCP 设置，DEBUG/INFO/WARNING/ERROR/CRITICAL）
# FASTMCP_LOG_LEVEL=INFO
# 应用日志：文件落盘（生产环境用），字段见 config.py LoggingConfig
# MCP_LOGGING__CONSOLE=true
# MCP_LOGGING__FILE=false
# MCP_LOGGING__FILE_PATH=logs
# MCP_LOGGING__JSON_FORMAT=true
# MCP_LOGGING__SEPARATE_ERROR_FILE=false
# 结构化请求日志中间件（官方 StructuredLoggingMiddleware）
# MCP_LOGGING__INCLUDE_PAYLOADS=false
# MCP_LOGGING__ESTIMATE_PAYLOAD_TOKENS=false