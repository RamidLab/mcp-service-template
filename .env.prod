MCP_HOST=0.0.0.0
MCP_PORT=8001

# 框架级日志级别（官方 FastMCP 设置）
FASTMCP_LOG_LEVEL=WARNING

# 应用日志：文件落盘（生产环境）
MCP_LOGGING__CONSOLE=false
MCP_LOGGING__FILE=true
MCP_LOGGING__FILE_PATH=prod_logs
MCP_LOGGING__FILE_BASE_NAME=service_mcp
MCP_LOGGING__BACKUP_COUNT=100
MCP_LOGGING__MAX_FILE_SIZE=104857600
MCP_LOGGING__JSON_FORMAT=true
MCP_LOGGING__SEPARATE_ERROR_FILE=true
MCP_LOGGING__ERROR_FILE_BASE_NAME=service_mcp_error

# 结构化请求日志中间件（官方 StructuredLoggingMiddleware）
MCP_LOGGING__INCLUDE_PAYLOADS=false
MCP_LOGGING__INCLUDE_PAYLOAD_LENGTH=false
MCP_LOGGING__ESTIMATE_PAYLOAD_TOKENS=true
