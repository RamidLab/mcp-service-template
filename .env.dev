MCP_HOST=0.0.0.0
MCP_PORT=8001

MCP_UI_PORT=8080
MCP_UI_RELOAD=true

# 框架级日志级别（官方 FastMCP 设置）
FASTMCP_LOG_LEVEL=DEBUG

# 应用日志：仅控制台（开发环境）
MCP_LOGGING__CONSOLE=true
MCP_LOGGING__FILE=false

# 结构化请求日志中间件（官方 StructuredLoggingMiddleware）
MCP_LOGGING__INCLUDE_PAYLOADS=true
MCP_LOGGING__INCLUDE_PAYLOAD_LENGTH=true
MCP_LOGGING__ESTIMATE_PAYLOAD_TOKENS=true
